# ============================================================================
# SUZUKI IGNIS SPORT EUROPE HUNTER — Environment configuration
# Copy this file to .env and fill in the values you have. Everything is
# optional except that AI features stay disabled (deterministic fallback) if
# no ANTHROPIC_API_KEY is provided. The system MUST run without any of these.
# NEVER commit a real .env file. NEVER put a real key in this example file.
# ============================================================================

# --- Claude / Anthropic AI layer (optional but recommended) ----------------
# When unset, the AI modules degrade gracefully to deterministic heuristics.
ANTHROPIC_API_KEY=
# Model name is configurable — do not hardcode in source.
ANTHROPIC_MODEL=claude-opus-4-8
# Cheaper model for high-volume/low-stakes calls (source triage etc.).
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Hard monthly budget guard (USD, estimated). 0 disables the guard.
AI_MONTHLY_BUDGET_USD=25

# --- Database --------------------------------------------------------------
# SQLite by default. Swap to a postgresql+psycopg:// URL later without code
# changes. Path is relative to the project root.
DATABASE_URL=sqlite:///data/ignis_hunter.db

# --- Scheduler -------------------------------------------------------------
# Times of day (local TZ) for full scans of known sources.
SCAN_TIMES=00:00,06:00,12:00,18:00
# Timezone for the scheduler.
TIMEZONE=Europe/Berlin
# Hour of day to run the daily source-discovery expansion.
DISCOVERY_HOUR=03

# --- Search / Discovery providers (optional) -------------------------------
# Provider used for search-engine discovery. Options: none, serpapi, brave,
# google_cse, bing. "none" uses only sitemap/feed/seed-list discovery.
SEARCH_PROVIDER=none
SERPAPI_KEY=
BRAVE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=
BING_API_KEY=

# --- Crawler behaviour -----------------------------------------------------
# Be a polite citizen. Respect robots.txt, throttle, identify yourself.
USER_AGENT=IgnisSportHunter/1.0 (+https://github.com/justtheboisgang/suzuki.ignis.sport.scanner)
REQUEST_TIMEOUT=20
CRAWL_DELAY_SECONDS=2.0
MAX_PAGES_PER_SOURCE=40
RESPECT_ROBOTS=true

# --- Classification thresholds --------------------------------------------
# Minimum match confidence (0-100) for a listing to be shown by default.
MATCH_CONFIDENCE_THRESHOLD=60
# Confidence at/above which a hit is escalated to a HOT alert.
HOT_ALERT_CONFIDENCE=85

# --- Notifications (all optional; console + DB always work) ----------------
# Comma-separated: console,database,telegram,discord,email
NOTIFY_CHANNELS=console,database
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Dashboard -------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
