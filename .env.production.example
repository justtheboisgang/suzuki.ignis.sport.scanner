# ============================================================================
# PRODUCTION environment for the Suzuki Ignis Sport Europe Hunter.
# Copy to .env on the VPS:  cp .env.production.example .env  &&  edit.
# NEVER commit the real .env. NEVER put real secrets in THIS example file.
# The system runs without any of these, but real discovery needs at least one
# search provider, and the AI layer needs ANTHROPIC_API_KEY.
# ============================================================================

# --- Claude / Anthropic (recommended) --------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Monthly AI spend cap (USD). Warn at 80%, stop non-critical calls at 100%.
ANTHROPIC_MONTHLY_COST_BUDGET=25

# --- Search providers (enable Brave AND optionally SerpApi) -----------------
# Brave is the primary real provider. Get a key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
SEARCH_PROVIDER_BRAVE_ENABLED=true
BRAVE_MONTHLY_REQUEST_BUDGET=2000

# SerpApi is the optional complementary (Google) index. https://serpapi.com/
SERPAPI_API_KEY=
SEARCH_PROVIDER_SERPAPI_ENABLED=false
SERPAPI_MONTHLY_REQUEST_BUDGET=100

# Pagination depth: high-value (chassis/exact/mislabelled) queries go deeper.
SEARCH_PAGES_DEFAULT=1
SEARCH_PAGES_HIGH_VALUE=3

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///data/ignis_hunter.db

# --- Scheduler --------------------------------------------------------------
SCAN_TIMES=00:00,06:00,12:00,18:00
TIMEZONE=Europe/Berlin
DISCOVERY_HOUR=3

# --- Crawler ----------------------------------------------------------------
USER_AGENT=IgnisSportHunter/1.0 (+https://github.com/justtheboisgang/suzuki.ignis.sport.scanner)
REQUEST_TIMEOUT=20
CRAWL_DELAY_SECONDS=2.0
MAX_PAGES_PER_SOURCE=40
RESPECT_ROBOTS=true

# --- Classification / alerts ------------------------------------------------
MATCH_CONFIDENCE_THRESHOLD=60
HOT_ALERT_CONFIDENCE=85

# --- Notifications (console + database always on) ---------------------------
NOTIFY_CHANNELS=console,database,telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Dashboard --------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
